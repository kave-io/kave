[Unit]
Description=Kave Daemon — Control Plane for AI Agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kave
Group=kave
WorkingDirectory=/var/lib/kave
Environment=HOME=/var/lib/kave
ExecStart=/usr/bin/kave-server
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
