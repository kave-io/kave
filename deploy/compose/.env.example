# Kave self-host configuration
# Copy to .env and adjust as needed.

# Image version — use a specific tag in production (e.g. v0.1.0)
KAVE_VERSION=latest

# Port mappings
KAVE_HTTP_PORT=18080    # Dashboard + HTTP proxy
KAVE_GRPC_PORT=19090    # gRPC control API
KAVE_PROXY_PORT=18081   # LLM proxy (used by SDKs)
