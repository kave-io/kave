#!/usr/bin/env sh
set -eu

is_kave_shim() {
	[ -f "$1" ] && grep -q 'KAVE_CODEX_SHIM' "$1" 2>/dev/null
}

restore_or_remove() {
	path="$1"
	if ! is_kave_shim "$path"; then
		return
	fi
	real_default="$(awk -F"'" '/^KAVE_CODEX_REAL_DEFAULT=/{print $2; exit}' "$path" 2>/dev/null || true)"
	rm -f "$path"
	if [ -n "$real_default" ]; then
		ln -s "$real_default" "$path"
		printf '%s\n' "Restored Codex launcher -> $path"
	else
		printf '%s\n' "Removed Codex shim -> $path"
	fi
}

bin_dir="${KAVE_BIN_DIR:-$HOME/.local/bin}"
restore_or_remove "$bin_dir/codex"

active="$(command -v codex || true)"
if [ -n "$active" ]; then
	restore_or_remove "$active"
fi
